@page
@model Markly.Web.Pages.Bookmarks.IndexModel
@{
    ViewData["Title"] = "My bookmarks";
}

<h1>My bookmarks</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add bookmark</a>
</p>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="tagId" value="@Model.TagId" />
    <input type="hidden" name="favorites" value="@(Model.FavoritesOnly ? "true" : "false")" />
    <div class="col">
        <input type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Search title, URL or description" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<div class="btn-group mb-3">
    <a asp-page="Index" asp-route-tagId="@Model.TagId" asp-route-search="@Model.Search"
       class="btn btn-outline-secondary @(Model.FavoritesOnly ? "" : "active")">All</a>
    <a asp-page="Index" asp-route-tagId="@Model.TagId" asp-route-search="@Model.Search" asp-route-favorites="true"
       class="btn btn-outline-secondary @(Model.FavoritesOnly ? "active" : "")">★ Favorites</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Search))
{
    <p>
        Results for <strong>@Model.Search</strong>
        · <a asp-page="Index" asp-route-tagId="@Model.TagId" asp-route-favorites="@Model.FavoritesOnly">Clear search</a>
    </p>
}

@if (Model.FilterTag != null)
{
    <p>
        Showing bookmarks tagged
        <span class="badge" style="background-color: @Model.FilterTag.Color">@Model.FilterTag.Name</span>
        · <a asp-page="Index" asp-route-favorites="@Model.FavoritesOnly" asp-route-search="@Model.Search">Remove tag filter</a>
    </p>
}

@if (Model.Bookmarks.Count == 0)
{
    <p>No bookmarks found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Title</th>
                <th>URL</th>
                <th>Collection</th>
                <th>Tags</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bookmark in Model.Bookmarks)
            {
                <tr>
                    <td>
                        <form method="post" asp-page-handler="ToggleFavorite"
                              asp-route-id="@bookmark.Id"
                              asp-route-tagId="@Model.TagId"
                              asp-route-favorites="@Model.FavoritesOnly"
                              asp-route-search="@Model.Search">
                            <button type="submit" class="btn btn-link p-0 text-decoration-none fs-5"
                                    title="@(bookmark.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                                @(bookmark.IsFavorite ? "★" : "☆")
                            </button>
                        </form>
                    </td>
                    <td>@bookmark.Title</td>
                    <td><a href="@bookmark.Url" target="_blank" rel="noopener">@bookmark.Url</a></td>
                    <td>@bookmark.Collection?.Name</td>
                    <td>
                        @if (Model.TagsByBookmark.TryGetValue(bookmark.Id, out var tags))
                        {
                            foreach (var tag in tags)
                            {
                                <a asp-page="Index" asp-route-tagId="@tag.Id"
                                   asp-route-favorites="@Model.FavoritesOnly" asp-route-search="@Model.Search"
                                   class="badge text-decoration-none"
                                   style="background-color: @tag.Color">@tag.Name</a>
                            }
                        }
                    </td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@bookmark.Id">Edit</a> |
                        <a asp-page="Delete" asp-route-id="@bookmark.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}